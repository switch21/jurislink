generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== TENANT ====================
model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  address       String?
  phone         String?
  email         String?
  plan          String   @default("starter") // starter, premium, enterprise
  maxUsers      Int      @default(3)
  maxStorageGb  Int      @default(5)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users        User[]
  clients      Client[]
  cases        Case[]
  invoices     Invoice[]
  documents    Document[]
  messages     Message[]
  events       Event[]
  auditLogs    AuditLog[]
  notifications Notification[]
  tasks        Task[]
}

// ==================== USER ====================
model User {
  id                  String   @id @default(cuid())
  email               String
  name                String
  password            String?
  role                String   @default("lawyer") // root_admin, associate, lawyer, jurist, assistant, accountant, client
  avatarUrl           String?
  phone               String?
  preferredLanguage   String   @default("fr")
  isActive            Boolean  @default(true)
  failedLoginAttempts Int     @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  mfaEnabled          Boolean  @default(false)
  mfaSecret           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenantId            String?
  tenant              Tenant?  @relation(fields: [tenantId], references: [id])

  assignedCases       CaseAssignment[]
  assignedEvents      EventAssignment[]
  sentMessages        Message[]  @relation("SentMessages")
  receivedMessages    Message[]  @relation("ReceivedMessages")
  createdDocuments    Document[]
  auditLogs           AuditLog[]
  caseNotes           CaseNote[]
  receivedNotifications Notification[] @relation("UserNotifications")
  assignedTasks       Task[]
  createdTasks        Task[]  @relation("TaskCreator")

  @@unique([tenantId, email])
}

// ==================== CLIENT ====================
model Client {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  company       String?
  clientType    String   @default("particulier") // particulier, entreprise
  niu           String?  // Numéro d'Identification Unique
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String   @default("Cameroun")
  notes         String?
  riskLevel     String   @default("faible") // faible, moyen, eleve
  source        String?  // bouche_a_oreille, internet, recommandation, autre
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  cases     Case[]
  invoices  Invoice[]
}

// ==================== CASE ====================
model Case {
  id              String   @id @default(cuid())
  reference       String
  title           String
  description     String?
  type            String   @default("civil") // civil, penal, commercial, social, administratif
  status          String   @default("nouveau") // nouveau, ouvert, en_cours, en_attente, clos, archive
  outcome         String?  // favorable, defavorable, en_negociation, abandonne
  paymentStatus   String?  // non_paye, partiel, paye, exonere
  priority        String   @default("normal") // basse, normal, haute, urgente
  isSecret        Boolean  @default(false)
  nextDueDate     DateTime?
  closingDate     DateTime?
  archivableAfter DateTime?
  niu             String?
  // New fields from objectifs.md
  adversary       String?  // Partie adverse
  jurisdiction    String?  // Juridiction (ex: TPI de Douala)
  amountInDispute Float?   // Montant en jeu
  billingType     String?  // forfait, horaire, abonnement, success_fee, provision
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])

  assignments   CaseAssignment[]
  documents     Document[]
  events        Event[]
  invoices      Invoice[]
  notes         CaseNote[]
  tasks         Task[]
}

model CaseAssignment {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  caseId  String
  case    Case   @relation(fields: [caseId], references: [id])

  @@unique([userId, caseId])
}

model CaseNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseId  String
  case     Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  @@index([caseId])
}

// ==================== DOCUMENT ====================
model Document {
  id            String   @id @default(cuid())
  name          String
  fileName      String
  fileType      String
  fileSize      Int
  filePath      String
  version       Int      @default(1)
  isFinal       Boolean  @default(false) // version officielle
  folder        String?  // Procédure, Contrats, Pièces client, Correspondances, Décisions, Factures, Archives
  tags          String?  // comma-separated tags for search
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

// ==================== EVENT ====================
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  eventType   String   @default("audience") // audience, rdv, echeance, depot, autre
  criticality String   @default("normal") // basse, normal, haute, urgente
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])

  assignments   EventAssignment[]
  notifications Notification[]
  tasks         Task[]
}

model EventAssignment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

// ==================== INVOICE ====================
model Invoice {
  id            String   @id @default(cuid())
  reference     String
  amount        Float
  status        String   @default("non_paye") // non_paye, partiel, paye, annule
  type          String   @default("facture") // devis, facture, avoir, recu
  dueDate       DateTime?
  paidDate      DateTime?
  paidAmount    Float?
  notes         String?
  paymentMethod String?  // especes, virement, mobile_money, carte
  billingType   String?  // forfait, horaire, abonnement, success_fee, provision
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  currencyCode String  @default("XAF")

}

// ==================== MESSAGE ====================
model Message {
  id        String   @id @default(cuid())
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

// ==================== NOTIFICATION ====================
model Notification {
  id           String   @id @default(cuid())
  title        String
  message      String
  category     String   @default("dossier") // dossier, echeance, document, facture, message, securite, tache
  priority     String   @default("info") // info, warning, urgent, critical
  isRead       Boolean  @default(false)
  resourceType String?
  resourceId   String?
  createdAt    DateTime @default(now())

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?   @relation("UserNotifications", fields: [userId], references: [id])
  eventId   String?
  event     Event?  @relation(fields: [eventId], references: [id])
}

// ==================== TASK ====================
model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("a_faire") // a_faire, en_cours, terminee, annulee
  priority    String   @default("normal") // basse, normal, haute, urgente
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  userId    String?  // assignee
  user      User?    @relation(fields: [userId], references: [id])
  creatorId String?
  creator   User?    @relation("TaskCreator", fields: [creatorId], references: [id])
  eventId   String?  // auto-generated from event workflow
  event     Event?  @relation(fields: [eventId], references: [id])

  @@index([caseId])
  @@index([userId])
  @@index([status])
}



// ==================== AUDIT LOG ====================
model AuditLog {
  id           String   @id @default(cuid())
  action       String
  resourceType String?
  resourceId   String?
  metadata     String?  // JSON string
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
}



// ==================== PERMISSION ====================
model Permission {
  id       String @id @default(cuid())
  role     String
  resource String
  action   String
  allowed  Boolean @default(false)

  @@unique([role, resource, action])
  @@index([role])
}

// ==================== CURRENCY ====================
model Currency {
  id     String @id @default(cuid())
  code   String @unique
  name   String
  symbol String
}
