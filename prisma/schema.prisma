generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== TENANT ====================
model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  address       String?
  phone         String?
  email         String?
  plan          String   @default("starter") // starter, premium, enterprise
  maxUsers      Int      @default(3)
  maxStorageGb  Int      @default(5)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users      User[]
  clients    Client[]
  cases      Case[]
  invoices   Invoice[]
  documents  Document[]
  messages   Message[]
  events     Event[]
  auditLogs  AuditLog[]
  notifications Notification[]
}

// ==================== USER ====================
model User {
  id                  String   @id @default(cuid())
  email               String
  name                String
  password            String?
  role                String   @default("lawyer") // root_admin, firm_admin, lawyer, secretary, client
  avatarUrl           String?
  phone               String?
  preferredLanguage   String   @default("fr")
  isActive            Boolean  @default(true)
  failedLoginAttempts Int     @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  mfaEnabled          Boolean  @default(false)
  mfaSecret           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenantId            String?
  tenant              Tenant?  @relation(fields: [tenantId], references: [id])

  assignedCases       CaseAssignment[]
  assignedEvents      EventAssignment[]
  sentMessages        Message[]  @relation("SentMessages")
  receivedMessages    Message[]  @relation("ReceivedMessages")
  createdDocuments    Document[]
  auditLogs           AuditLog[]
  caseNotes           CaseNote[]
  receivedNotifications Notification[] @relation("UserNotifications")

  @@unique([tenantId, email])
}

// ==================== CLIENT ====================
model Client {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  company   String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  cases     Case[]
  invoices  Invoice[]
}

// ==================== CASE ====================
model Case {
  id              String   @id @default(cuid())
  reference       String
  title           String
  description     String?
  type            String   @default("civil") // civil, penal, commercial, social, admin
  status          String   @default("nouveau") // nouveau, ouvert, en_cours, en_attente, clos, archive
  outcome         String?  // favorable, defavorable, en_negociation, abandonne
  paymentStatus   String?  // non_paye, partiel, paye, exonere
  priority        String   @default("normal") // basse, normal, haute, urgente
  isSecret        Boolean  @default(false)
  nextDueDate     DateTime?
  closingDate     DateTime?
  archivableAfter DateTime?
  niu             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id])

  assignments   CaseAssignment[]
  documents     Document[]
  events        Event[]
  invoices      Invoice[]
  notes         CaseNote[]
}

model CaseAssignment {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  caseId  String
  case    Case   @relation(fields: [caseId], references: [id])

  @@unique([userId, caseId])
}

model CaseNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caseId  String
  case     Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  @@index([caseId])
}

// ==================== DOCUMENT ====================
model Document {
  id          String   @id @default(cuid())
  name        String
  fileName    String
  fileType    String
  fileSize    Int
  filePath    String
  version     Int      @default(1)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

// ==================== EVENT ====================
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  eventType   String   @default("audience") // audience, rdv, echeance, depot, autre
  criticality String   @default("normal") // basse, normal, haute, urgente
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id])

  assignments   EventAssignment[]
  notifications Notification[]
}

model EventAssignment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

// ==================== INVOICE ====================
model Invoice {
  id          String   @id @default(cuid())
  reference   String
  amount      Float
  status      String   @default("non_paye") // non_paye, partiel, paye, annule
  dueDate     DateTime?
  paidDate    DateTime?
  paidAmount  Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  caseId      String?
  case        Case?    @relation(fields: [caseId], references: [id])
  currencyCode String  @default("XAF")
}

// ==================== MESSAGE ====================
model Message {
  id        String   @id @default(cuid())
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  senderId    String
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId  String
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

// ==================== NOTIFICATION ====================
model Notification {
  id          String   @id @default(cuid())
  title       String
  message     String
  category    String   @default("dossier") // dossier, echeance, document, facture, message, securite
  isRead      Boolean  @default(false)
  resourceType String?
  resourceId   String?
  createdAt   DateTime @default(now())

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?   @relation("UserNotifications", fields: [userId], references: [id])
  eventId   String?
  event     Event?  @relation(fields: [eventId], references: [id])
}

// ==================== AUDIT LOG ====================
model AuditLog {
  id           String   @id @default(cuid())
  action       String
  resourceType String?
  resourceId   String?
  metadata     String?  // JSON string
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
}

// ==================== CURRENCY ====================
model Currency {
  id     String @id @default(cuid())
  code   String @unique
  name   String
  symbol String
}
